<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Hybrid|x64">
      <Configuration>Hybrid</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectName>CADDimension</ProjectName>
    <ProjectGuid>{75e6d57f-3cde-4066-a3cf-8b2280699325}</ProjectGuid>
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <VCToolsVersion>14.38.33130</VCToolsVersion>
    <MaxSDK Condition="'$(MaxSDK)' == ''">$(MAXSDK_DIR)</MaxSDK>
    <WindowsTargetPlatformVersion>10.0.19041.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <Import Project="$(MaxSDK)\ProjectSettings\PropertySheets\3dsmax.general.project.settings.props"
          Condition="'$(MaxSDK)' != '' and Exists('$(MaxSDK)\ProjectSettings\PropertySheets\3dsmax.general.project.settings.props')" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(MaxSDK)\ProjectSettings\PropertySheets\3dsmax.cpp.props"
            Condition="'$(MaxSDK)' != '' and Exists('$(MaxSDK)\ProjectSettings\PropertySheets\3dsmax.cpp.props')" />
  </ImportGroup>
  <PropertyGroup>
    <_ProjectFileVersion>10.0.30319.1</_ProjectFileVersion>
    <OutDir Condition="'$(OutDir)' == ''">$(ProjectDir)x64\$(Configuration)\Plugins\</OutDir>
    <IntDir Condition="'$(IntDir)' == ''">$(ProjectDir)obj\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>CADDimension</TargetName>
    <TargetExt>.dlo</TargetExt>
    <!-- The SDK ships only lib\x64\Release. All configurations link the same
         release libraries and must therefore use the /MD release CRT. -->
    <MaxSdkLib>$(MaxSdkDir)lib\$(Platform)\Release\</MaxSdkLib>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WholeProgramOptimization>false</WholeProgramOptimization>
      <PreprocessorDefinitions>_USRDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MaxSdkInc);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <WarningLevel>Level4</WarningLevel>
      <BufferSecurityCheck>true</BufferSecurityCheck>
      <SDLCheck>true</SDLCheck>
      <ControlFlowGuard Condition="'$(Configuration)'=='Release'">Guard</ControlFlowGuard>
      <UndefinePreprocessorDefinitions Condition="'$(Configuration)'=='Debug'">_DEBUG;%(UndefinePreprocessorDefinitions)</UndefinePreprocessorDefinitions>
      <UndefinePreprocessorDefinitions Condition="'$(Configuration)'=='Hybrid'">_HYBRID;IS_HYBRID;%(UndefinePreprocessorDefinitions)</UndefinePreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Configuration)'=='Debug'">NDEBUG;SECURE_SCL=0;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Configuration)'=='Hybrid'">NDEBUG;SECURE_SCL=0;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <BasicRuntimeChecks Condition="'$(Configuration)'=='Debug'">EnableFastChecks</BasicRuntimeChecks>
      <BasicRuntimeChecks Condition="'$(Configuration)'=='Hybrid'">Default</BasicRuntimeChecks>
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug' or '$(Configuration)'=='Hybrid'">MultiThreadedDLL</RuntimeLibrary>
      <AdditionalOptions>/Brepro %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(Configuration)'=='Debug' or '$(Configuration)'=='Hybrid'">/D_ITERATOR_DEBUG_LEVEL=0 /Brepro %(AdditionalOptions)</AdditionalOptions>
      <ProgramDataBaseFileName>$(ProjectDir)obj\repro\CADDimension.pdb</ProgramDataBaseFileName>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(MaxSdkLib);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>bmm.lib;core.lib;Geom.lib;gfx.lib;mesh.lib;maxutil.lib;maxscrpt.lib;manipsys.lib;paramblk2.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <ProgramDatabaseFile>$(ProjectDir)obj\repro\CADDimension.pdb</ProgramDatabaseFile>
      <PDBALTPATH>$(TargetName).pdb</PDBALTPATH>
      <StripPrivateSymbols>$(ProjectDir)obj\repro\$(TargetName).stripped.pdb</StripPrivateSymbols>
      <GenerateDebugInformation Condition="'$(Configuration)'=='Release' and '$(BuildSymbols)' != 'true'">false</GenerateDebugInformation>
      <ControlFlowGuard Condition="'$(Configuration)'=='Release'">Guard</ControlFlowGuard>
      <AdditionalOptions>/OPT:NOICF /Brepro /PDBALTPATH:$(TargetName).pdb %(AdditionalOptions)</AdditionalOptions>
      <LinkIncremental Condition="'$(Configuration)'=='Debug' or '$(Configuration)'=='Hybrid'">false</LinkIncremental>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="ValidateMaxSdk" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(MaxSDK)' == ''"
           Text="MAXSDK_DIR is not set. Set it to the 3ds Max SDK root (e.g. D:\3dsMaxSDK2027\maxsdk) or pass /p:MaxSDK=&lt;sdk-root&gt;." />
    <Error Condition="'$(MaxSDK)' != '' and !Exists('$(MaxSDK)\ProjectSettings\PropertySheets\3dsmax.general.project.settings.props')"
           Text="3ds Max SDK property sheets not found under '$(MaxSDK)'. Check MAXSDK_DIR / MaxSDK." />
  </Target>
  <Target Name="ValidateToolchain" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(PlatformToolset)' != 'v143'" Text="PlatformToolset must be v143 (actual: '$(PlatformToolset)')." />
    <Error Condition="'$(VCToolsVersion)' != '14.38.33130'" Text="VCToolsVersion must be 14.38.33130 (actual: '$(VCToolsVersion)')." />
    <Error Condition="'$(WindowsTargetPlatformVersion)' != '10.0.19041.0'" Text="WindowsTargetPlatformVersion must be 10.0.19041.0 (actual: '$(WindowsTargetPlatformVersion)')." />
    <Error Condition="!Exists('$(MaxSDK)\ProjectSettings\PropertySheets\3dsmax.cpp.props')" Text="3dsmax.cpp.props not found under '$(MaxSDK)'." />
    <Error Condition="'$(IsMaxProjectInDevTree)' == 'true'" Text="IsMaxProjectInDevTree must not be true." />
  </Target>
  <ItemGroup>
    <ClCompile Include="CADDimension.cpp" />
    <ClCompile Include="CADDimensionBounds.cpp" />
    <ClCompile Include="CADDimensionClone.cpp" />
    <ClCompile Include="CADDimensionCreate.cpp" />
    <ClCompile Include="CADDimensionDraw.cpp" />
    <ClCompile Include="CADDimensionHit.cpp" />
    <ClCompile Include="CADDimensionThreePoint.cpp" />
    <ClCompile Include="CADDimensionUI.cpp" />
    <ClCompile Include="CADLeader.cpp" />
    <ClCompile Include="CADTable.cpp" />
    <ClCompile Include="CADText.cpp" />
    <ClCompile Include="Common\CADDraw.cpp" />
    <ClCompile Include="Common\CADHit.cpp" />
    <ClCompile Include="DllEntry.cpp" />
  </ItemGroup>
  <ItemGroup>
    <None Include="CADDimension.def" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="3dsmaxsdk_preinclude.h" />
    <ClInclude Include="CADDimension.h" />
    <ClInclude Include="CADLeader.h" />
    <ClInclude Include="CADTable.h" />
    <ClInclude Include="CADText.h" />
    <ClInclude Include="Common\CADDraw.h" />
    <ClInclude Include="Common\CADHit.h" />
    <ClInclude Include="resource.h" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="CADDimension.rc" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
